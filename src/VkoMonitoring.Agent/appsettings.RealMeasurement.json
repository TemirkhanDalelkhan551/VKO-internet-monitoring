{
  "Agent": {
    "DataDirectory": "data/real-measurements",
    "DispatchIntervalSeconds": 5,
    "RunImmediatelyOnStartup": true,
    "ApiBaseUrl": "http://localhost:5080/",
    "DownloadTestUrl": "https://speed.cloudflare.com/__down?bytes=5000000",
    "UploadTestUrl": "https://speed.cloudflare.com/__up",
    "PingHost": "1.1.1.1"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
